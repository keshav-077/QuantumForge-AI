# CryoForge RL — AfterQuery "Break the Agent" Environment Configuration
# Copy to .env (never committed) or pass via `--env-file <path>` to scripts/run_eval.py

# Frontier / Small Model Evaluation Providers (set whichever credits you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Default Models for 1-Command Evaluation
CRYOFORGE_FRONTIER_PROVIDER=gemini
CRYOFORGE_FRONTIER_MODEL=gemini-4-argon
CRYOFORGE_SMALL_MODEL=gemma-4-26b-a4b-it

# Harbor CLI Command Override (when running inside AfterQuery Harbor + OpenCode)
HARBOR_BIN=harbor

# Optional Modal Token for Cloud QLoRA SFT Tiebreaker (`modal run tiebreaker/train_sft.py`)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Replay Dashboard Port
CRYOFORGE_PORT=8095
